# ─── Serveur ───
PORT=3000
NODE_ENV=development

# ─── Firebase Admin SDK ───
# Option 1 : fichier de clé JSON (RECOMMANDÉ)
# GOOGLE_APPLICATION_CREDENTIALS=C:\chemin\vers\firebase-key.json

# Option 2 : variables individuelles (commente la ligne ci-dessus si tu utilises celle-ci)
# FIREBASE_PROJECT_ID=votre-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@votre-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=votre-project.appspot.com

# ─── JWT ───
JWT_ACCESS_SECRET=changez-moi-access-secret-min-32-caracteres
JWT_REFRESH_SECRET=changez-moi-refresh-secret-min-32-caracteres
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Admin par défaut (seed) ───
ADMIN_EMAIL=admin@ecole.com
ADMIN_PASSWORD=Admin123!
